; Engine configuration file.
; Monster Ultra Bros. - White Edition

config_version=5

[application]

config/name="Monster Ultra Bros. - White Edition"
config/description="A classic 2D platformer starring a can of Monster Energy Ultra White."
config/version="1.0.0"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
config/quit_on_go_back=false
run/max_fps=60
boot_splash/bg_color=Color(0.137, 0.145, 0.176, 1)
boot_splash/show_image=false
config/use_custom_user_dir=false

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"
driver/output_latency=30

[autoload]

Settings="*res://scripts/autoload/settings.gd"
SaveSystem="*res://scripts/autoload/save_system.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
GameState="*res://scripts/autoload/game_state.gd"
FX="*res://scripts/autoload/fx.gd"
UITheme="*res://scripts/autoload/ui_theme.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true
window/vsync/vsync_mode=1

[gui]

theme/custom="res://assets/ui/theme.tres"
theme/custom_font="res://assets/fonts/ultrapixel.ttf"
theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
2d/default_gravity=980.0

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemies"
2d_physics/layer_4="items"
2d_physics/layer_5="platforms"
2d_physics/layer_6="hazards"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.07, 0.07, 0.1, 1)
2d/snap/snap_2d_transforms_to_pixel=false
2d/snap/snap_2d_vertices_to_pixel=false
